{
  "name": "Ironfronts Preview",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm ci",
  "postStartCommand": "nohup npm run dev -- --host 0.0.0.0 > /tmp/ironfronts-vite.log 2>&1 &",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Ironfronts Preview",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.startupEditor": "none"
      }
    }
  }
}
