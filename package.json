{
  "name": "ironfronts-renderer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:world",
    "dev": "vite",
    "build:world": "node scripts/build-world.mjs",
    "build": "npm run build:world && tsc --noEmit && vite build",
    "check": "tsc --noEmit && npm run lint:scripts && npm run test:architecture && vitest run",
    "lint:scripts": "eslint \"scripts/**/*.mjs\"",
    "preview": "vite preview",
    "pretest": "npm run build:world",
    "test": "vitest run",
    "test:architecture": "vitest run tests/architecture.test.ts",
    "visual-check": "node scripts/visual-check.mjs",
    "performance-check": "node scripts/performance-check.mjs"
  },
  "dependencies": {
    "@fontsource/bitter": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "gl-matrix": "^3.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webgpu/types": "^0.1.64",
    "eslint": "^10.9.1",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "webgpu": "^0.4.0",
    "wgsl_reflect": "^1.5.0"
  }
}
